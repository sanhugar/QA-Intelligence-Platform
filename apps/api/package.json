{
  "name": "@ati/api",
  "version": "0.0.0",
  "private": true,
  "description": "ATI Backend HTTP API host (modular monolith)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "echo \"Lint not configured for WP-1.1\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch"
  },
  "dependencies": {
    "@ati/config": "workspace:*",
    "@ati/errors": "workspace:*",
    "@ati/logger": "workspace:*",
    "@ati/shared-constants": "workspace:*",
    "@ati/shared-types": "workspace:*",
    "@ati/shared-utils": "workspace:*",
    "@ati/shared-validation": "workspace:*",
    "@nestjs/common": "^11.0.12",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/testing": "^11.0.12",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
