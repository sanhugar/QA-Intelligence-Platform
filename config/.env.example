# Example environment template — copy to a local .env (never commit real secrets)

ATI_NODE_ENV=development
ATI_LOG_LEVEL=info

# WP-1.1 host ports
ATI_API_PORT=3000
ATI_WORKER_PORT=3001
ATI_WEB_PORT=5173

# Deferred (not required for WP-1.1 host bootstrap)
# ATI_DATABASE_URL=postgresql://user:pass@localhost:5432/ati
# ATI_REDIS_URL=redis://localhost:6379
# ATI_STORAGE_ENDPOINT=http://localhost:9000
# ATI_OIDC_ISSUER_URL=
# ATI_OIDC_CLIENT_ID=
# ATI_OIDC_CLIENT_SECRET=
